<?xml version="1.0" encoding="utf-8"?>
<!--
  The Cairo font family, weight-mapped.

  Registered as the JS-visible family "Cairo" by MainApplication.kt via
  ReactFontManager.addCustomFont — that registration is what lets a shared
  style say { fontFamily: 'Cairo', fontWeight: '600' } and receive the real
  SemiBold face on API 28+ instead of a synthetically bolded Regular.

  Both the android: and app: attribute namespaces are populated: the
  framework reads android: on API 26+, androidx's ResourcesCompat reads
  app: below that. Weights above 700 are intentionally absent — the type
  scale caps at Bold (see src/ui/theme/typography.ts).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/cairo_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/cairo_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/cairo_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/cairo_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/cairo_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/cairo_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/cairo_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/cairo_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
